{
  "tests": [
    {
      "name": "Регистрация нового пользователя",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "register",
        "firstName": "Иван",
        "lastName": "Тестов",
        "city": "Симферополь",
        "age": 25,
        "phone": "+79991234500",
        "password": "secret123"
      },
      "expectedStatus": 200,
      "expectedBody": { "ok": true },
      "bodyMatcher": "partial"
    },
    {
      "name": "Вход с правильным паролем",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "login",
        "phone": "+79991234500",
        "password": "secret123"
      },
      "expectedStatus": 200,
      "expectedBody": { "ok": true },
      "bodyMatcher": "partial"
    },
    {
      "name": "Вход с неверным паролем",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "login",
        "phone": "+79991234500",
        "password": "wrongpass"
      },
      "expectedStatus": 401,
      "expectedBody": { "ok": false },
      "bodyMatcher": "partial"
    }
  ]
}
