{
  "tests": [
    {
      "name": "Успешная регистрация",
      "method": "POST",
      "path": "/",
      "body": {
        "firstName": "Иван",
        "lastName": "Тестов",
        "city": "Симферополь",
        "age": 25,
        "phone": "+79991234567"
      },
      "expectedStatus": 200,
      "expectedBody": { "ok": true },
      "bodyMatcher": "partial"
    },
    {
      "name": "Блокировка возраста < 20",
      "method": "POST",
      "path": "/",
      "body": {
        "firstName": "Юный",
        "lastName": "Тест",
        "city": "Ялта",
        "age": 17,
        "phone": "+79997654321"
      },
      "expectedStatus": 400,
      "expectedBody": { "ok": false },
      "bodyMatcher": "partial"
    },
    {
      "name": "Неверный формат телефона",
      "method": "POST",
      "path": "/",
      "body": {
        "firstName": "Иван",
        "lastName": "Тест",
        "city": "Керчь",
        "age": 30,
        "phone": "89991234567"
      },
      "expectedStatus": 400,
      "expectedBody": { "ok": false },
      "bodyMatcher": "partial"
    }
  ]
}
